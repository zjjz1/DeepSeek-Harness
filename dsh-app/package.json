{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面启动器 - 无边框沉浸式窗口",
  "main": "main.js",
  "author": "小鲸",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.harness",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "voice-xfyun.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node-v24.19.0-x64.msi",
        "to": "nodejs/node-v24.19.0-x64.msi"
      },
      {
        "from": "build/pnpm",
        "to": "pnpm"
      },
      {
        "from": "C:/Users/31773/Desktop/deepseek-harness",
        "to": "harness",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/.agents/**",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "include": "build/installer.nsh"
    }
  }
}
